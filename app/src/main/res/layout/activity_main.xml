<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="20dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leo游戏加速器"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leo Game Accelerator"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击连接开始加速"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/nodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前节点: 未选择"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="连接加速"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_connect"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="默认订阅: http://t.leocok.cn:2096/clash/zibamzwco99t84mv"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginTop="30dp"
        android:gravity="center" />

</LinearLayout>